    "use_cache": true,
    "vocab_size": 32000,
    "attn_tensorized": "True",
    "attn_factorization": "tt_sparse",
    "attn_shape": [12, 8, 8, 8, 8, 12],
    "attn_rank": 128,
    "pff_tensorized": "True",
    "pff_factorization": "tt_sparse",
    "pff_shape": [[16, 16, 8, 8, 8, 12], [12, 8, 8, 8, 16, 16]],
    "pff_rank": [256, 256],
    "tie_word_embeddings": true
